{
  "name": "chatbeds-marketing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:bg": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-server.ps1 start",
    "dev:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-server.ps1 status",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-server.ps1 stop",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "lucide-react": "^0.577.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
