# Public demo scheduling URL and optional contact/site configuration.
# Without a booking URL, demo requests open an email draft for the contact below.
# Use the public Google Calendar appointment booking URL for demos.
NEXT_PUBLIC_DEMO_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contact@chatbeds.app
NEXT_PUBLIC_SITE_URL=https://chatbeds.app

# Optional: approved public signup URL. Leave empty to use Book a Demo.
NEXT_PUBLIC_SIGNUP_URL=
# Enable only when the Founding 100 offer is confirmed live.
NEXT_PUBLIC_FOUNDING_100_ENABLED=false
